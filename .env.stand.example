# Copy to .env to run the suite against the local stand (scripts/stand-up.sh).
BASE_URL=http://localhost:4200
API_BASE_URL=http://localhost:8091

# The stand is ours, so writes are exercised for real rather than intercepted.
MOCK_CONTACT_API=false

# The stand answers in milliseconds; a 30s default would only hide hangs.
TIMEOUT_MS=10000

# Record the checkout video for the showcase.
RECORD_VIDEO=false
